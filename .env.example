# EVA backend configuration
# Copy this file to `.env` and configure the values.

# --- General ---
# Environment: development, staging, or production
ENVIRONMENT=development
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- CORS & Mock Auth ---
# CORS_ORIGINS: JSON array of allowed origins for browser clients
CORS_ORIGINS=["http://localhost:3000"]
# MOCK_AUTH_ENABLED: set to true to bypass real authentication during development
MOCK_AUTH_ENABLED=true

# --- Database ---
# DATABASE_URL: async SQLAlchemy database DSN
DATABASE_URL=postgresql+asyncpg://eva:eva@localhost:5432/eva
# DB_POOL_SIZE: database connection pool size
DB_POOL_SIZE=10
# DB_MAX_OVERFLOW: maximum database connections allowed beyond pool size
DB_MAX_OVERFLOW=5

# --- Google Gemini ---
# GOOGLE_API_KEY: API key for Gemini models
GOOGLE_API_KEY=
# GEMINI_MODEL: model used for reasoning turns
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_AUDIO_MODEL: model used for audio streaming
GEMINI_AUDIO_MODEL=gemini-2.0-flash

# --- Embeddings & Vector Index (PGVector) ---
# EMBEDDING_MODEL: Google embedding model name
EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIM: vector dimensionality (768 for text-embedding-004)
EMBEDDING_DIM=768
# VECTOR_INDEX_TYPE: PGVector index type (hnsw or ivfflat)
VECTOR_INDEX_TYPE=hnsw
# HNSW_M: max number of connection links per node in HNSW index
HNSW_M=16
# HNSW_EF_CONSTRUCTION: size of dynamic candidate list during HNSW index build
HNSW_EF_CONSTRUCTION=64

# --- Langfuse Observability ---
# LANGFUSE_PUBLIC_KEY: public key for Langfuse tracking (optional in Sprint 1)
LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY: secret key for Langfuse tracking (optional in Sprint 1)
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST: endpoint URL for Langfuse server
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Reasoning ---
# MAX_TOOL_CALLS_PER_TURN: limit of tool calls allowed per single turn
MAX_TOOL_CALLS_PER_TURN=6
# RETRIEVAL_TOP_K: number of document results to retrieve per query
RETRIEVAL_TOP_K=5
