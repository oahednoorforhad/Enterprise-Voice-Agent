# EVA backend configuration
# Copy this file to `.env` and configure the values.

# --- General ---
# Environment: development, staging, or production
ENVIRONMENT=development
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- CORS & Mock Auth ---
# CORS_ORIGINS: JSON array of allowed origins for browser clients
CORS_ORIGINS=["http://localhost:3000"]
# MOCK_AUTH_ENABLED: set to true to bypass real authentication during development
MOCK_AUTH_ENABLED=true

# --- OAuth & JWT ---
# GOOGLE_CLIENT_ID: OAuth 2.0 client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET: OAuth 2.0 client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI: callback URL after Google login
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/google
# JWT_SECRET: secret key used to sign JWT tokens (change in production!)
JWT_SECRET=change_me_in_production
# JWT_ALGORITHM: signing algorithm for JWT tokens
JWT_ALGORITHM=HS256
# ADMIN_SECRET_KEY: secret key for admin API endpoints (change in production!)
ADMIN_SECRET_KEY=change_me_admin_secret

# --- Database ---
# DATABASE_URL: async SQLAlchemy database DSN
DATABASE_URL=postgresql+asyncpg://eva:eva@localhost:5432/eva
# DB_POOL_SIZE: database connection pool size
DB_POOL_SIZE=10
# DB_MAX_OVERFLOW: maximum database connections allowed beyond pool size
DB_MAX_OVERFLOW=5

# --- Google Gemini (Google AI — dev default) ---
# GOOGLE_API_KEY: API key for Gemini models (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# GEMINI_MODEL: model used for reasoning/text turns
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_AUDIO_MODEL: model used for Gemini Live audio streaming (Google AI)
GEMINI_AUDIO_MODEL=gemini-2.5-flash-native-audio-dialog

# --- Vertex AI (production alternative — set VERTEXAI_ENABLED=true to use) ---
# VERTEXAI_ENABLED: use Vertex AI instead of Google AI key (provides SLA)
VERTEXAI_ENABLED=false
# GCP_PROJECT: Google Cloud project ID (required if VERTEXAI_ENABLED=true)
GCP_PROJECT=
# GCP_LOCATION: GCP region for Vertex AI (us-central1 recommended)
GCP_LOCATION=us-central1
# GEMINI_AUDIO_MODEL_VERTEX: Vertex AI model ID for Live audio
GEMINI_AUDIO_MODEL_VERTEX=gemini-live-2.5-flash-native-audio

# --- Embeddings & Vector Index (PGVector) ---
# EMBEDDING_MODEL: Google embedding model name
EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIM: vector dimensionality (768 for text-embedding-004)
EMBEDDING_DIM=768
# VECTOR_INDEX_TYPE: PGVector index type (hnsw or ivfflat)
VECTOR_INDEX_TYPE=hnsw
# HNSW_M: max number of connection links per node in HNSW index
HNSW_M=16
# HNSW_EF_CONSTRUCTION: size of dynamic candidate list during HNSW index build
HNSW_EF_CONSTRUCTION=64

# --- Langfuse Observability ---
# LANGFUSE_PUBLIC_KEY: public key for Langfuse tracking (optional in Sprint 1)
LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY: secret key for Langfuse tracking (optional in Sprint 1)
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST: endpoint URL for Langfuse server
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Reasoning ---
# MAX_TOOL_CALLS_PER_TURN: limit of tool calls allowed per single turn
MAX_TOOL_CALLS_PER_TURN=6
# RETRIEVAL_TOP_K: number of document results to retrieve per query
RETRIEVAL_TOP_K=5
