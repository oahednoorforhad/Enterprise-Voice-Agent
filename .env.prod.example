# Production environment — copy to .env.prod and fill in real values.
# NEVER commit .env.prod to git.

# === Server ===
DOMAIN=eva.oahed.live
LETSENCRYPT_EMAIL=your@email.com
GITHUB_USERNAME=your-github-username

# === Application ===
ENVIRONMENT=production
LOG_LEVEL=INFO
MOCK_AUTH_ENABLED=false

# === Database ===
# Use internal Docker hostname 'postgres' (not localhost)
DATABASE_URL=postgresql+asyncpg://eva:eva@postgres:5432/eva
POSTGRES_PASSWORD=change_this_to_a_strong_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# === CORS ===
# Must match your DOMAIN exactly
CORS_ORIGINS=["https://eva.oahed.live"]

# === Google Gemini ===
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash-native-audio-dialog

# === Auth & JWT ===
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ADMIN_SECRET_KEY=generate_with_openssl_rand_hex_32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# FRONTEND_URL: base URL of the frontend — backend redirects browser here after OAuth success
FRONTEND_URL=https://eva.oahed.live
GOOGLE_REDIRECT_URI=https://eva.oahed.live/api/v1/auth/callback/google

# === Sentry (Error Monitoring — free at sentry.io) ===
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# === Langfuse (LLM Observability — optional) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# === Vector / Embeddings ===
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
VECTOR_INDEX_TYPE=hnsw
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
RETRIEVAL_TOP_K=5
MAX_TOOL_CALLS_PER_TURN=6
